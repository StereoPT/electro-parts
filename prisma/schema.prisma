generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Component {
  id              Int      @id @default(autoincrement())
  name            String
  manufacturer    String?
  description     String?
  quantity        Int      @default(0)
  // Normalized identity (see src/lib/componentIdentity.ts); "" = no Manufacturer.
  nameKey         String
  manufacturerKey String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([nameKey, manufacturerKey])
}
